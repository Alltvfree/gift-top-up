# =============================================================================
# XAUUSD MT5 Trading Bot — environment variables (EXAMPLE)
# =============================================================================
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#   cp .env.example .env
# =============================================================================

# --- Trading mode: BACKTEST | PAPER | DEMO | LIVE -----------------------------
# Default is PAPER. LIVE additionally requires BOT_ALLOW_LIVE=true (see below)
# plus an explicit in-app confirmation before any live order is sent.
TRADING_MODE=PAPER

# --- MT5 terminal credentials (only needed for DEMO / LIVE) -------------------
# Leave blank for BACKTEST / PAPER, which use the mock adapter.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Absolute path to terminal64.exe (Windows). Blank = let MT5 auto-detect.
MT5_TERMINAL_PATH=

# --- Live-trading safety switch ----------------------------------------------
# Must be explicitly set to `true` for TRADING_MODE=LIVE to be accepted.
BOT_ALLOW_LIVE=false

# --- Database (used from Phase 3 onward) -------------------------------------
# Local dev can use SQLite; production uses PostgreSQL.
DATABASE_URL=sqlite:///./data/bot.db

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=INFO
# Directory for rotating log files (created if missing).
LOG_DIR=./logs

# --- API / dashboard (used from Phase 6 onward) ------------------------------
# API_HOST=127.0.0.1
# API_PORT=8000
# JWT_SECRET=

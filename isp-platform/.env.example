# ---- Host ports (change any that are already used on this server: `./scripts/check-ports.sh`)
HTTPS_PORT=8443          # web UI: https://<server>:8443
HTTP_PORT=8081           # only redirects to HTTPS_PORT
API_LOCAL_PORT=8000      # loopback only, for health checks from the host
RADIUS_AUTH_PORT=1812    # if another RADIUS already uses 1812/1813 here, pick others and point the NAS at them
RADIUS_ACCT_PORT=1813
# Internal Docker network; must not overlap your management / island subnets
DOCKER_SUBNET=172.31.250.0/24

POSTGRES_DB=isp_platform
POSTGRES_USER=isp_app
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql://isp_app:REPLACE_WITH_A_LONG_RANDOM_PASSWORD@db:5432/isp_platform

# Encrypts router/OLT credentials at rest. Generate once and BACK IT UP; losing it means re-entering every device password:
#   docker run --rm python:3.12-slim sh -c "pip -q install cryptography && python -c 'from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())'"
APP_SECRET_KEY=

# Password for the least-privilege 'radius' database role used by FreeRADIUS
RADIUS_DB_PASSWORD=REPLACE_WITH_ANOTHER_LONG_RANDOM_PASSWORD

# Optional: POST {"text": "..."} on every new/resolved alert (Slack/Mattermost/Telegram-bridge webhook)
ALERT_WEBHOOK_URL=

# Optional: airFiber vendor OIDs, confirmed with snmpwalk on YOUR radios (see docs/NETWORK-SETUP.md)
# AIRFIBER_OIDS={"rx_capacity_bps":"1.3.6.1.4.1.41112....","remote_rssi_dbm":"1.3.6.1.4.1.41112...."}

# Roles that must use two-factor sign-in (authenticator app). Add noc,billing to require it more widely.
MFA_REQUIRED_ROLES=admin
# Name shown in the authenticator app
MFA_ISSUER=SatLink

# Threat protection: block hosts brute-forcing router logins on every MikroTik (see docs/SECURITY.md)
THREAT_AUTO_BLOCK=true
THREAT_FAILURES=5          # failed logins from one public IP ...
THREAT_WINDOW_MIN=30       # ... within this many minutes -> blocked
THREAT_BLOCK_HOURS=168     # auto-blocks expire after 7 days
THREAT_SUBNET_AFTER=3      # this many blocked IPs in one /24 -> the whole /24 is blocked
# Networks never auto-blocked, comma separated (private ranges are never auto-blocked anyway)
THREAT_NEVER_BLOCK=

# SMS via MessageOwl (msgowl.com): access key from the MessageOwl console; sender ID must be approved there.
# Empty key = SMS off (messages stay queued and are sent once a key is set).
MSGOWL_ACCESS_KEY=
MSGOWL_SENDER_ID=SatLink

POLL_INTERVAL_S=60
FOUR_EYES=true

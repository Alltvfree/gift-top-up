POSTGRES_DB=isp_platform
POSTGRES_USER=isp_app
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql://isp_app:REPLACE_WITH_A_LONG_RANDOM_PASSWORD@db:5432/isp_platform

# Encrypts router/OLT credentials at rest. Generate once and BACK IT UP; losing it means re-entering every device password:
#   docker run --rm python:3.12-slim sh -c "pip -q install cryptography && python -c 'from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())'"
APP_SECRET_KEY=

# Password for the least-privilege 'radius' database role used by FreeRADIUS
RADIUS_DB_PASSWORD=REPLACE_WITH_ANOTHER_LONG_RANDOM_PASSWORD

# Optional: POST {"text": "..."} on every new/resolved alert (Slack/Mattermost/Telegram-bridge webhook)
ALERT_WEBHOOK_URL=

# Optional: airFiber vendor OIDs, confirmed with snmpwalk on YOUR radios (see docs/NETWORK-SETUP.md)
# AIRFIBER_OIDS={"rx_capacity_bps":"1.3.6.1.4.1.41112....","remote_rssi_dbm":"1.3.6.1.4.1.41112...."}

# Roles that must use two-factor sign-in (authenticator app). Add noc,billing to require it more widely.
MFA_REQUIRED_ROLES=admin
# Name shown in the authenticator app
MFA_ISSUER=IslandNet ISP

POLL_INTERVAL_S=60
FOUR_EYES=true

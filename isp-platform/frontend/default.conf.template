# Template: the nginx image substitutes ${PUBLIC_HTTPS_PORT} at start (only defined env vars are replaced,
# so nginx variables like $host are left alone).
server_tokens off;
limit_req_zone $binary_remote_addr zone=login:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=api:10m rate=20r/s;
limit_conn_zone $binary_remote_addr zone=perip:10m;
limit_req_status 429;
limit_conn_status 429;

map $http_user_agent $bad_bot {
    default 0;
    ~*(sqlmap|nikto|masscan|zgrab|nmap|nuclei|dirbuster|gobuster|wpscan) 1;
    "" 1;
}

server {
    listen 80;
    server_name _;
    include /etc/nginx/allowlist.conf;
    return 301 https://$host:${PUBLIC_HTTPS_PORT}$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;
    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    include /etc/nginx/allowlist.conf;
    limit_conn perip 30;
    client_max_body_size 1m;
    client_body_timeout 10s;
    client_header_timeout 10s;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;
    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # Re-resolve the api container through Docker's DNS: after `docker compose up --build` it gets a
    # new IP, and a hostname fixed at nginx start would keep pointing at the old one (HTTP 502).
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api_upstream http://api:8000;

    root /usr/share/nginx/html;
    index index.html;

    if ($bad_bot) { return 444; }
    if ($request_method !~ ^(GET|HEAD|POST|PUT|PATCH|DELETE)$) { return 405; }
    location ~ /\. { return 404; }

    location = /api/auth/login {
        limit_req zone=login burst=5 nodelay;
        proxy_pass $api_upstream;
        proxy_set_header X-Real-IP $remote_addr;
    }
    location /api/import/ {
        client_max_body_size 25m;     # CSV exports of every subscriber
        limit_req zone=api burst=10 nodelay;
        proxy_pass $api_upstream;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 300s;
    }
    location /api/ {
        limit_req zone=api burst=60 nodelay;
        proxy_pass $api_upstream;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 180s;   # OLT autofind / change apply can be slow
    }
    location = /health { proxy_pass $api_upstream; }
    # Browsers re-check the UI files on every load (cheap 304s), so an update shows up at once.
    location / { expires -1; try_files $uri /index.html; }
}

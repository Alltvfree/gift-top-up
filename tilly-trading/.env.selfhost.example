# Tilly Trading — self-host env for docker-compose.selfhost.yml
# Copy to `.env.selfhost` on your server and fill in the three secrets.

APP_NAME=Tilly Trading
ENVIRONMENT=production
DEBUG=false

# ----- Supabase database (session pooler, IPv4) -----
# Already filled for this project; only change if you rotate the DB password.
DATABASE_URL=postgresql+asyncpg://postgres.vvkddynlfgilymzvugfo:Xr9ctuvHFNCGdNtw@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
DATABASE_PGBOUNCER=false

# ----- Supabase auth (verify web-app tokens) -----
# Supabase → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=
SUPABASE_URL=https://vvkddynlfgilymzvugfo.supabase.co

# ----- MetaAPI (broker) -----
# app.metaapi.cloud → Tokens
METAAPI_TOKEN=
METAAPI_REGION=new-york
METAAPI_PLATFORM=mt5

# ----- CORS: the browser origin(s) allowed to call this API -----
CORS_ORIGINS=https://gift-top-up1.pages.dev,http://localhost:3000

# ----- Bot engine -----
ENGINE_TICK_SECONDS=5

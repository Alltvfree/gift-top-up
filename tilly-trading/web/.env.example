NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_RcfbwbF2ubNMG5sfKxKRhA_57IUq1Sh

# Deployed Tilly backend (FastAPI) URL — needed for broker linking (Task 3).

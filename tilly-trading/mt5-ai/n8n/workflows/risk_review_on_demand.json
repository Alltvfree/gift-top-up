        }
      }
    },
    {
      "parameters": {
        "jsCode": "\nconst blocks = $json.content || [];\nconst text = blocks.map(b => b.text || '').join('').trim();\nreturn [{ json: { text: '\ud83e\udde0 ' + (text || '(the AI returned no text)') } }];\n"
      },
      "id": "5b87c0e8-d0ae-5851-b6f6-8c313b16dc22",
      "name": "Extract text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,

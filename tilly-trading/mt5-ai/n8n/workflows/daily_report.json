    {
      "parameters": {
        "jsCode": "\nconst st = $('GET status').first().json;\nconst pos = $('GET positions').first().json;\nconst j = $('GET journal').first().json;\nconst L = [];\nL.push('\ud83d\udccb Daily report');\nL.push(`Account ${st.account.account} (${st.account.mode}) | balance ${st.account.balance} | equity ${st.account.equity}`);\nL.push(`Today ${st.today.realized_pnl_all_strategies} | loss budget left ${st.today.loss_budget_left} | trades left ${st.today.trades_left_today}`);\nif (pos.positions.length === 0) { L.push('No open trades.'); }\nfor (const p of pos.positions) {\n  L.push(`#${p.position} ${p.side} ${p.lots} ${p.symbol} now ${p.price_now} | ${p.profit_now}` + (p.r_now !== null ? ` (${p.r_now}R)` : ''));\n}\nconst o = j.overall || {};\nL.push(o.trades ? `Journal: ${o.trades} closed, win rate ${o.win_rate}, mean ${o.mean_r}R. ${o.reading}` : 'Journal: no closed trades yet.');\nreturn [{ json: { text: L.join('\\n') } }];\n"
      },

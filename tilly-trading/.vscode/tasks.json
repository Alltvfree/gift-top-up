{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend: install deps",
      "type": "shell",
      "command": "python -m venv .venv && . .venv/bin/activate && pip install -r requirements.txt",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "backend: dev",
      "type": "shell",
      "command": "uvicorn app.main:app --reload --port 8000",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "backend: test",
      "type": "shell",
      "command": "pytest -q",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "web: install deps",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/web" },
      "problemMatcher": []
    },
    {
      "label": "web: dev",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/web" },
      "problemMatcher": [],
      "isBackground": true
    }
  ]
}

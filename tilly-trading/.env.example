# ============================================================================
# Tilly Trading — environment configuration
# Copy this file to `.env` and fill in the values before running the stack.
#   cp .env.example .env
# ============================================================================

# ----- App -----------------------------------------------------------------
APP_NAME=Tilly Trading
ENVIRONMENT=development           # development | staging | production
DEBUG=true

# ----- Ports (host-side) ---------------------------------------------------
BACKEND_PORT=8000
WEB_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# ----- PostgreSQL ----------------------------------------------------------
POSTGRES_USER=tilly
POSTGRES_PASSWORD=tilly
POSTGRES_DB=tilly
# Async URL used by the app (SQLAlchemy 2.0 + asyncpg).
# When running via docker-compose this is overridden to use the `db` host.
DATABASE_URL=postgresql+asyncpg://tilly:tilly@localhost:5432/tilly
# Sync URL used by Alembic migrations.
DATABASE_URL_SYNC=postgresql+psycopg2://tilly:tilly@localhost:5432/tilly

# ----- Redis / Celery ------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ----- Security / Auth (JWT) ----------------------------------------------
# Generate a strong secret, e.g.  openssl rand -hex 32
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----- CORS ----------------------------------------------------------------
# Comma-separated list of allowed origins for the browser client.
CORS_ORIGINS=http://localhost:3000

# ----- Broker: MetaAPI (Exness / XM / Vantage via MetaTrader) --------------
# Get a token from https://app.metaapi.cloud/
METAAPI_TOKEN=
METAAPI_REGION=new-york
# Default MetaAPI account (provisioning) id used when none is supplied.
METAAPI_DEFAULT_ACCOUNT_ID=

# ----- AI preset generator (optional LLM assist) ---------------------------
# Leave blank to use the built-in heuristic preset generator only.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ----- Frontend ------------------------------------------------------------
# Base URL the browser uses to reach the API.
NEXT_PUBLIC_API_URL=http://localhost:8000

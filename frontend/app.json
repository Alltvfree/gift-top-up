{
  "expo": {
    "name": "Tilly",
    "slug": "tilly-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.tilly.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.tilly.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "display": "standalone",
      "orientation": "portrait"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Tilly to access your camera",
          "microphonePermission": "Allow Tilly to access your microphone"
        }
      ]
    ],
    "scheme": "tilly"
  }
}

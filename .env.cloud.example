# Tilly Super App - Cloud Deployment Environment Variables

# ============================================
# SUPABASE CONFIGURATION
# ============================================
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# How to get these:
# 1. Go to https://supabase.com
# 2. Create a new project
# 3. Go to Project Settings → API
# 4. Copy the Project URL, Anon Key, and Service Role Key

# ============================================
# CLOUDFLARE CONFIGURATION
# ============================================
CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN
CLOUDFLARE_ACCOUNT_ID=YOUR_ACCOUNT_ID
CLOUDFLARE_ZONE_ID=YOUR_ZONE_ID

# How to get these:
# 1. Go to https://dash.cloudflare.com
# 2. For API Token: My Profile → API Tokens → Create Token
# 3. For Account ID: Sidebar → Overview (shown at bottom right)
# 4. For Zone ID: Your domain → Overview (shown at bottom right)

# ============================================
# BACKEND ENVIRONMENT
# ============================================
NODE_ENV=production
LOG_LEVEL=info
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY=7d

# ============================================
# FRONTEND ENVIRONMENT
# ============================================
EXPO_PUBLIC_API_URL=https://tilly-api.YOUR_DOMAIN.workers.dev/api/v1
EXPO_PUBLIC_APP_NAME=Tilly
EXPO_PUBLIC_VERSION=0.1.0

# ============================================
# CORS CONFIGURATION
# ============================================
CORS_ORIGIN=https://your-project.pages.dev

# ============================================
# OPTIONAL: PAYMENT GATEWAY
# ============================================
PAYMENT_GATEWAY_API_KEY=your_payment_gateway_key
PAYMENT_GATEWAY_SECRET=your_payment_gateway_secret

# ============================================
# OPTIONAL: TELECOM PROVIDER APIs
# ============================================
FASEYHA_API_KEY=your_faseyha_api_key
FASEYHA_API_URL=https://api.faseyha.mv

# ============================================
# OPTIONAL: UTILITY PROVIDER APIs
# ============================================
STELCO_API_KEY=your_stelco_api_key
MWA_API_KEY=your_mwa_api_key

# ============================================
# EMAIL CONFIGURATION (for notifications)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password

# ============================================
# SMS CONFIGURATION (for 2FA/notifications)
# ============================================
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

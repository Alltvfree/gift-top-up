{
  "name": "tilly-app-backend",
  "version": "0.1.0",
  "description": "Backend API for Tilly Super App - Digital payments, telecom, and utility services",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "typescript": "^5.2.0",
    "@types/express": "^4.17.17",
    "@types/node": "^20.4.0",
    "dotenv": "^16.3.1",
    "pg": "^8.11.1",
    "redis": "^4.6.7",
    "hono": "^3.12.0",
    "@supabase/supabase-js": "^2.38.0",
    "jsonwebtoken": "^9.0.2",
    "@types/jsonwebtoken": "^9.0.3",
    "bcryptjs": "^2.4.3",
    "@types/bcryptjs": "^2.4.6",
    "joi": "^17.10.0",
    "axios": "^1.5.0",
    "helmet": "^7.0.0",
    "cors": "^2.8.5",
    "morgan": "^1.10.0",
    "winston": "^3.10.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "tsx": "^3.14.0",
    "vitest": "^0.34.2",
    "@vitest/ui": "^0.34.2",
    "eslint": "^8.46.0",
    "@typescript-eslint/eslint-plugin": "^6.3.0",
    "@typescript-eslint/parser": "^6.3.0",
    "prettier": "^3.0.0",
    "@types/pg": "^8.10.2",
    "@types/cors": "^2.8.14",
    "@types/morgan": "^1.9.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
